# Copy to .env at the repository root. No secrets needed in Part 1.
GOV_APP_NAME="Government Policy Assistant"
GOV_ENVIRONMENT=development
# JSON array; only loopback HTTP origins are accepted in this foundation.
GOV_CORS_ORIGINS=["http://127.0.0.1:5173"]
# Run: .\.venv\Scripts\python.exe backend\manage.py configure
# That command writes real secrets privately. These values are placeholders.
GOV_DB_HOST=127.0.0.1
GOV_DB_PORT=5432
GOV_DB_NAME=gov_policy
GOV_DB_USER=gov_app
GOV_TEST_DB_NAME=gov_policy_test
GOV_TEST_DB_USER=gov_test
# Leave secrets unset until interactive configuration (liveness still works).
# GOV_DB_PASSWORD=
# GOV_TEST_DB_PASSWORD=
# GOV_JWT_SECRET=
GOV_COOKIE_SECURE=false
